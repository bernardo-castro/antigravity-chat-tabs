{
  "name": "antigravity-chat-tabs",
  "displayName": "Antigravity Chat Tabs",
  "description": "Professional multi-session tab suite for the Antigravity IDE Agent panel, featuring per-tab context isolation, a floating multi-monitor AI Aura companion, and per-workspace persistence.",
  "version": "1.6.1",
  "publisher": "BernardoCastroDev",
  "author": {
    "name": "Bernardo Castro",
    "url": "https://github.com/bernardo-castro"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bernardo-castro/antigravity-chat-tabs.git"
  },
  "homepage": "https://github.com/bernardo-castro/antigravity-chat-tabs#readme",
  "bugs": {
    "url": "https://github.com/bernardo-castro/antigravity-chat-tabs/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Appearance"
  ],
  "keywords": [
    "antigravity",
    "chat",
    "tabs",
    "agent",
    "sessions"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:antigravityChatTabs.ensureGravitoOverlay"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravityChatTabs.enable",
        "title": "Antigravity Chat Tabs: Enable Session Tabs"
      },
      {
        "command": "antigravityChatTabs.disable",
        "title": "Antigravity Chat Tabs: Restore Default Header"
      },
      {
        "command": "antigravityChatTabs.status",
        "title": "Antigravity Chat Tabs: Check Status"
      },
      {
        "command": "antigravityChatTabs.ensureGravitoOverlay",
        "title": "Antigravity Chat Tabs: Launch Floating Companion"
      }
    ],
    "configuration": {
      "title": "Antigravity Chat Tabs",
      "properties": {
        "antigravityChatTabs.autoApplyOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-apply the Session Tabs bar whenever Antigravity IDE updates."
        }
      }
    }
  }
}
